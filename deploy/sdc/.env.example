# Copy to .env (same folder as docker-compose.yml) and edit.

# Image tags loaded on this VM (docker images).
BIOMARK_IMAGE_TAG=sdc-2026.11.11
CADDY_IMAGE_TAG=2-alpine

# What users type in the browser: the SDC-issued DNS name, or the VM's IP until there is one.
BIOMARK_HOSTNAME=10.5.93.57

# TLS: "internal" = self-signed (browser warning) until SDC issues a certificate.
# With the SDC certificate in ./certs:  BIOMARK_TLS=/certs/cert.pem /certs/key.pem
BIOMARK_TLS=internal

# The hospital whose slides are analysed (shown on every result and report).
BIOMARK_SITE_NAME=Government Medical College Kottayam
# Scanner microns per pixel for that site (Medprime scans received from K-DISC: 0.286).
BIOMARK_SITE_MPP=0.286
# Local validation record. Empty = AI pre-score withheld (shadow mode). See Deployment Guide.
BIOMARK_SITE_VALIDATION=

# Analyses run at the same time (others queue). 1 on 4 vCPU / 8 GB; 2 with 8 vCPU / 16 GB.
BIOMARK_ANALYSIS_SLOTS=1
